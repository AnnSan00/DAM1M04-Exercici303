{{> header}}
{{> menu}}

<main class="container">
    <h1 class="title">Benvinguts a Sakila</h1>

    <section class="section">
        <h2>Top 5 Movies</h2>
        <div class="card-grid"> {{#each movies}}
            <div class="card">
                <h2>{{this.title}}</h2>
                <p>Any: {{this.release_year}}</p>
                </div>
            {{/each}}
        </div>
    </section>

    <section class="section">
        <h2>Categories</h2>
        <div class="card-grid">
            {{#each categories}}
            <div class="card">
                <h2>{{this.name}}</h2>
            </div>
            {{/each}}
        </div>
    </section>
</main>

{{> footer}}